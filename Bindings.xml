<Bindings>
	<!-- Ka0s Quick Comms (launcher-§6): every binding sits in the addon's own category, BINDING_HEADER_QUICKCOMMS,
	     which Options -> Keybindings titles with the brand, and none carries a header attribute (a blank spacer row there).
	     The names never change: the client keeps a player's key against the name. The labels, the category
	     global and NS.BINDINGS (the same commands in this order, which the General page's Keybindings tab
	     draws) are set in settings/SlashVerbs.lua and modules/Dial.lua.
	     Toggle Comms Pads, first (the Show window binding): clicks the plain QuickCommsTogglePads button
	     (settings/SlashVerbs.lua), whose click runs /qc toggle's handler (V.TogglePads). -->
	<Binding name="CLICK QuickCommsTogglePads:LeftButton" category="BINDING_HEADER_QUICKCOMMS"/>
	<!-- Open Comms Dial 1-4 (design spec §9.4, P7): each clicks the dial header at that place in the dial
	     order (modules/Dial_Secure.lua names them QuickCommsDial<n>) with the Toggle button. A dial's key IS
	     one of these bindings, set in Options -> Keybindings or on General > Keybindings. -->
	<Binding name="CLICK QuickCommsDial1:Toggle" category="BINDING_HEADER_QUICKCOMMS"/>
	<Binding name="CLICK QuickCommsDial2:Toggle" category="BINDING_HEADER_QUICKCOMMS"/>
	<Binding name="CLICK QuickCommsDial3:Toggle" category="BINDING_HEADER_QUICKCOMMS"/>
	<Binding name="CLICK QuickCommsDial4:Toggle" category="BINDING_HEADER_QUICKCOMMS"/>
</Bindings>
