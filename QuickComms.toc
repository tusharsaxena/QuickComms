## Interface: 120105
## Title: Ka0s Quick Comms
## Notes: Context-aware quick callouts on a Comms Pad and a ping-wheel-style Comms Dial, sent through secure buttons so they work in M+ keys and boss pulls
## Author: add1kted2ka0s
## Version: 0.1.0
## IconTexture: Interface\AddOns\QuickComms\media\logos\quickcomms.logo.128.tga
## SavedVariables: QuickCommsDB, QuickCommsPerfDB
## OptionalDeps: Ace3, LibStub, CallbackHandler-1.0, LibSharedMedia-3.0, LibDataBroker-1.1, LibDBIcon-1.0, LibDeflate, LibSerialize, LibCustomGlow-1.0, EllesmereUI
## DefaultState: enabled
## Category-enUS: Chat
## X-License: MIT
## X-Standard: https://github.com/tusharsaxena/WowAddonStandards
# X-Curse-Project-ID: not published on CurseForge yet

# Libraries (must load first) -- vendored in libs/, .xml where the lib ships one, else .lua
libs\LibStub\LibStub.lua
libs\CallbackHandler-1.0\CallbackHandler-1.0.xml
libs\AceAddon-3.0\AceAddon-3.0.xml
libs\AceEvent-3.0\AceEvent-3.0.xml
libs\AceTimer-3.0\AceTimer-3.0.xml
libs\AceConsole-3.0\AceConsole-3.0.xml
libs\AceDB-3.0\AceDB-3.0.xml
libs\AceGUI-3.0\AceGUI-3.0.xml
# LOAD-BEARING: AceConfigDialog-3.0 resolves AceGUI-3.0 with a non-silent LibStub at file load, so
# AceConfig-3.0.xml sits below AceGUI-3.0.xml. AceDBOptions resolves nothing at load.
libs\AceConfig-3.0\AceConfig-3.0.xml
libs\AceDBOptions-3.0\AceDBOptions-3.0.xml
libs\LibSharedMedia-3.0\lib.xml
# Conventional: LibKa0s-Launcher-1.0 resolves both at Register time; LibDBIcon needs the two above it.
libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
libs\LibDBIcon-1.0\lib.xml
# Conventional: the icon glows (LibKa0s-Glow-1.0 resolves it at call time). It resolves only LibStub at file load.
libs\LibCustomGlow-1.0\LibCustomGlow-1.0.xml
# ONE line: the .xml is itself the file list (library-stack-§7). After Ace3.
libs\LibKa0s\LibKa0s.xml
# LOAD-BEARING: modules\Share.lua takes LibDeflate at load (the share string's compression, spec §15).
libs\LibDeflate\lib.xml
# LOAD-BEARING: modules\Share.lua takes LibSerialize at load (the share string's payload, spec §15).
libs\LibSerialize\lib.xml

# Locales
# LOAD-BEARING: publishes NS.L, which every file below reads at load.
locales\enUS.lua

# Core -- dependency-correct order (layout-§1)
# LOAD-BEARING: publishes NS.name, NS.BRAND, NS.PREFIX and NS.SLASH, read at load below.
core\Namespace.lua
# LOAD-BEARING: publishes NS.Print / NS.Util.print and NS.LIBKA0S_MISSING, read at load below.
core\CoreSetup.lua
# Conventional: publishes NS.Compat, read inside functions only; resolves LibKa0s-Compat-1.0 at load (libraries load first).
core\Compat.lua
# LOAD-BEARING: publishes NS.EUIBridge, which settings\CalloutPopup_Skin.lua calls at load; every
# EllesmereUI read happens at call time (EllesmereUI is an OptionalDep, never required).
core\EUIBridge.lua
# LOAD-BEARING: publishes NS.MediaFont, which core\Constants.lua resolves FONT_MONO from at load.
core\MediaSetup.lua
# Conventional: data only, apart from FONT_MONO, resolved from the seam above.
core\Constants.lua
# Conventional: session-only state (NS.State); modules and settings take NS.State at load, which the folder order (core before modules and settings) pins; within # Core its position is free.
core\State.lua
# Conventional: NS.Meta / NS.Version are read inside functions only.
core\EnvSetup.lua
# Conventional: NS.Pool is read inside functions only.
core\PoolSetup.lua
# Conventional: NS.MakeDragHandle is read inside functions only (modules\Pad.lua).
core\WidgetsSetup.lua
# Conventional: NS.GlowLib (the LibKa0s-Glow-1.0 seam) is read inside functions only (modules\Glow.lua).
core\GlowSetup.lua
# LOAD-BEARING: publishes NS.MSG (the message catalog) and NS.Bus; every file that names a message
# takes NS.MSG at load.
core\Bus.lua
# LOAD-BEARING relative to core\PerfSetup.lua only, which hands NS.Lifecycle to lib:New at load.
core\LifecycleSetup.lua
# LOAD-BEARING: lib:New reads NS.Lifecycle (above) at load; any module taking `local Perf = NS.Perf`
# as a load-time upvalue loads below this line.
core\PerfSetup.lua
# LOAD-BEARING: the lib:New descriptor reads NS.Constants.FONT_MONO (core\Constants.lua, above) at
# load; publishes NS.Debug before any call site runs.
core\DebugLogSetup.lua
# LOAD-BEARING: promotes NS to the AceAddon object (NS.addon) and reclaims NS.Print; publishes
# NS.FEATURE_EVENTS / NS.STAND_DOWN / NS.STAND_UP; modules\ and settings\ read NS.addon at load.
core\QuickComms.lua
# Conventional: NS:RunMigrations is called from OnInitialize and the profile callbacks.
core\Database.lua
# Conventional: the launcher is built here and registered from OnEnable.
core\LauncherSetup.lua

# Defaults
# LOAD-BEARING: publishes NS.C, which settings\Schema.lua and settings\Panel.lua take at load.
defaults\Profile.lua
# LOAD-BEARING: NS.BuiltIns and its helpers, used by the next six files
defaults\BuiltIns.lua
# Conventional: data
defaults\BuiltIns_MythicPlus.lua
# Conventional: data
defaults\BuiltIns_Raid.lua
# Conventional: data
defaults\BuiltIns_Arena.lua
# Conventional: data
defaults\BuiltIns_World.lua
# Conventional: data
defaults\BuiltIns_Battlegrounds.lua
# Conventional: data (declared after the battleground sets: D9)
defaults\BuiltIns_Group.lua
# LOAD-BEARING: publishes NS.IconDefaults, which modules\Library.lua reads at load (SURFACE_DEFAULTS).
defaults\Icons.lua
# LOAD-BEARING: publishes NS.PadDefaults, which modules\Library.lua reads at load (SURFACE_DEFAULTS).
defaults\PadStyle.lua
# Conventional: data (the editors' and Preview as's shipped ids), read at call time
defaults\GameIds.lua
# Conventional: data (the When editor's instance and arena lists), read at call time
defaults\GameIds_Instances.lua

# Modules
# Conventional: read by Situation at call time; appends to NS.FEATURE_EVENTS / STAND_DOWN / STAND_UP
modules\Restrictions.lua
# Conventional: feature module; appends to NS.FEATURE_EVENTS / STAND_DOWN / STAND_UP
modules\Situation.lua
# Conventional: pure
modules\Tokens.lua
# Conventional: pure
modules\Channels.lua
# Conventional: pure; calls Tokens and Channels at call time
modules\Bake.lua
# Conventional: pure
modules\Resolver.lua
# Conventional: the registry writer (architecture-§5); Prepare is called from the entry after migrations
modules\Library.lua
# Conventional: the registry writer's schemaVersion steps, called by core\Database.lua's runner at run time
modules\Library_Migrate.lua
# Conventional: the share string's codec and checks (pure), and from Task 5 its edge; reads Bake, Library and the seam at run time
modules\Share.lua
# LOAD-BEARING: publishes NS.SendGuard, which modules\SendEngine.lua takes as a load-time upvalue.
modules\SendEngine_Guard.lua
# LOAD-BEARING: the only secure writer; publishes NS.SendEngine, which modules\Dial_Secure.lua takes as a load-time upvalue; appends to NS.STAND_DOWN / NS.STAND_UP (and, Task 4, NS.FEATURE_EVENTS)
modules\SendEngine.lua
# Conventional: test mode, TEST_MODE_CHANGED's sender; appends to NS.STAND_DOWN / NS.STAND_UP
modules\Preview.lua
# LOAD-BEARING: publishes NS.PadLayout, which modules\Pad_Render.lua and modules\Pad.lua take at load.
modules\Pad_Layout.lua
# LOAD-BEARING: publishes NS.IconStyle, which modules\Pad_Render.lua and modules\Dial_Render.lua take at load.
modules\IconStyle.lua
# LOAD-BEARING: publishes NS.Glow, which modules\Pad_Render.lua and modules\Dial_Render.lua take at load; appends to NS.STAND_DOWN.
modules\Glow.lua
# LOAD-BEARING: publishes NS.Shine (the shine overlay's catalog and the pad button painter), whose LOOKS settings\SchemaMembers.lua reads at file scope; modules\Pad_Render.lua calls it at run time.
modules\Shine.lua
# Conventional: the surfaces' plans and rebuild; calls modules\Pad.lua at run time only
modules\Surfaces.lua
# LOAD-BEARING: publishes NS.PadRender, which modules\Pad.lua takes as a load-time upvalue.
modules\Pad_Render.lua
# Conventional: the Comms Pad frames; appends to NS.STAND_DOWN / NS.STAND_UP
modules\Pad.lua
# LOAD-BEARING: publishes NS.DialLayout, which modules\Dial_Render.lua and modules\Dial.lua take at load.
modules\Dial_Layout.lua
# LOAD-BEARING: publishes NS.DialSecure, which modules\Dial.lua takes as a load-time upvalue.
modules\Dial_Secure.lua
# LOAD-BEARING: publishes NS.DialSlices, which modules\Dial_Render.lua takes as a load-time upvalue.
modules\Dial_Slices.lua
# LOAD-BEARING: publishes NS.DialRender, which modules\Dial.lua takes as a load-time upvalue.
modules\Dial_Render.lua
# Conventional: the Comms Dial frames; appends to NS.STAND_DOWN / NS.STAND_UP; modules\Surfaces.lua calls it at run time only.
modules\Dial.lua
# Conventional: core\DebugLogSetup.lua's descriptor reads NS.Diagnostics at RUN time.
modules\Diagnostics.lua

# Settings (last -- depend on everything else being initialized)
# LOAD-BEARING: publishes Settings.SchemaLib, which settings\Schema.lua calls :New on at file scope.
settings\SchemaSetup.lua
# LOAD-BEARING: publishes Settings.Schema, NS.SchemaRuntime, NS.Setting and Settings.RebuildSurfaces;
# settings\OptionsSetup.lua, settings\Panel.lua and settings\Slash.lua read NS.SchemaRuntime at load;
# settings\SchemaRows.lua's rows call Settings.RebuildSurfaces at run time.
settings\Schema.lua
# LOAD-BEARING: publishes the LibKa0s-Options instance as Settings.Helpers; settings\Panel.lua calls
# Helpers.MasterControls at file scope.
settings\OptionsSetup.lua
# LOAD-BEARING: reads NS.C and NS.SchemaRuntime.AddRows at file scope (NS.addon.Settings.RebuildSurfaces
# only when a row's onChange runs); loads before settings\Panel.lua,
# which splices the Master controls in ahead of these rows.
settings\SchemaRows.lua
# LOAD-BEARING: publishes Settings.IconRows, which settings\SchemaMembers.lua calls at file scope; reads
# NS.IconDefaults at file scope.
settings\SchemaIcons.lua
# LOAD-BEARING: reads NS.Library.TEMPLATES, NS.Channels.KINDS, NS.Shine.LOOKS, Settings.IconRows and NS.SchemaRuntime.AddRows at file scope.
settings\SchemaMembers.lua
# LOAD-BEARING: reads NS.C, Settings.Helpers and NS.SchemaRuntime.AddRows at file scope.
settings\Panel.lua
# LOAD-BEARING: publishes Settings.Editors, which the settings files below take at load; reads NS.MSG
# and NS.Bus at load.
settings\Editors.lua
# LOAD-BEARING: takes Settings.Editors at load; publishes Settings.Callouts (the token list and the
# preview lines), which settings\CalloutPopup.lua takes at load and settings\Groups.lua reads at run time.
settings\Callouts.lua
# Conventional: publishes Settings.ModalWindow, the window settings\CalloutPopup.lua and settings\IconBrowser.lua build at run time.
settings\ModalWindow.lua
# LOAD-BEARING: publishes Settings.IconBrowserSources, which settings\IconBrowser.lua takes at load.
settings\IconBrowser_Sources.lua
# Conventional: publishes Settings.IconBrowser; settings\Editors.lua and settings\CalloutPopup.lua open it at run time only.
settings\IconBrowser.lua
# LOAD-BEARING: takes Settings.Editors and Settings.Callouts at load and publishes Settings.CalloutPopup,
# which settings\CalloutPopup_Skin.lua takes at load; settings\Groups.lua opens it at run time only.
settings\CalloutPopup.lua
# LOAD-BEARING: takes Settings.CalloutPopup and NS.EUIBridge at load and registers with EllesmereUI at
# file load (an OptionalDep, so loaded first when present); settings\CalloutPopup.lua calls
# Settings.CalloutPopupSkin.TryApply at run time only.
settings\CalloutPopup_Skin.lua
# LOAD-BEARING: takes Settings.Editors at load; settings\Groups.lua calls Settings.GroupsWhen at run time only.
settings\Groups_When.lua
# LOAD-BEARING: takes Settings.Editors at load and registers the Groups page (after General).
settings\Groups.lua
# LOAD-BEARING: takes Settings.Editors at load and registers the Comms Pad page (after Groups).
settings\Pads.lua
# LOAD-BEARING: takes Settings.Editors at load and registers the Comms Dial page (after Comms Pad, before Share).
settings\Dials.lua
# LOAD-BEARING: takes Settings.Editors at load and registers the Share page (after Comms Dial, before Profiles).
settings\Share.lua
# Conventional: the verb bodies settings\Slash.lua's NS.COMMANDS rows call at run time; read modules only inside functions;
# makes Bindings.xml's Toggle Comms Pads button (QuickCommsTogglePads) at load.
settings\SlashVerbs.lua
# LOAD-BEARING: captures NS.SchemaRuntime.Get/Set/FindRow/ApplyDefault at load.
settings\Slash.lua
# LAST, so its RegisterOptionsPage call queues behind General's (options-ui-§3).
settings\Profiles.lua
